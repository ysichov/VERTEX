<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.views">
      <category
            id="org.selector.adt.ui.category"
            name="AXE"/>
      <view
            id="org.selector.adt.ui.view"
            name="SelecTor Data Explorer"
            category="org.selector.adt.ui.category"
            class="org.selector.adt.ui.SelectorView"
            allowMultiple="true"
            restorable="true"/>
      <view
            id="org.selector.adt.ui.view.metrics"
            name="AXE Metrics"
            category="org.selector.adt.ui.category"
            class="org.selector.adt.ui.MetricsView"
            allowMultiple="true"
            restorable="true"/>
   </extension>

   <extension point="org.eclipse.ui.commands">
      <command
            id="org.selector.adt.ui.command.metrics"
            name="Metrics"/>
      <command
            id="org.selector.adt.ui.command.data"
            name="SelecTor"/>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler
            commandId="org.selector.adt.ui.command.metrics"
            class="org.selector.adt.ui.MetricsHandler"/>
      <handler
            commandId="org.selector.adt.ui.command.data"
            class="org.selector.adt.ui.DataHandler"/>
   </extension>

   <!-- One submenu holding every service, rather than one top-level entry each:
        with several tools a flat list would crowd the context menu of every
        object. The visibility test sits on the menu, so it is evaluated once
        instead of once per command.

        Services differ in what they apply to - metrics to code, SelecTor to
        tables and views. Filtering that needs a PropertyTester, since plugin.xml
        has no built-in test for ADT object types; worth adding once a service is
        actually shown where it makes no sense. -->
   <extension point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <menu
               id="org.selector.adt.ui.menu"
               label="AXE">
            <visibleWhen checkEnabled="false">
               <with variable="selection">
                  <count value="1"/>
                  <iterate>
                     <adapt type="com.sap.adt.tools.core.IAdtObjectReference"/>
                  </iterate>
               </with>
            </visibleWhen>
            <command
                  commandId="org.selector.adt.ui.command.data"
                  label="SelecTor"
                  style="push"/>
            <command
                  commandId="org.selector.adt.ui.command.metrics"
                  label="Metrics"
                  style="push"/>
         </menu>
      </menuContribution>
   </extension>
</plugin>
