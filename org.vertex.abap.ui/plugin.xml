<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.preferencePages">
      <page id="org.vertex.abap.ui.assistant.preferences"
            name="VERTEX Assistant" class="org.vertex.abap.ui.AssistantPreferences"/>
      <page id="org.vertex.abap.ui.review.preferences"
            name="VERTEX Code Review" class="org.vertex.abap.ui.ReviewPreferences"/>
   </extension>
   <extension point="org.eclipse.ui.views">
      <view id="org.vertex.abap.ui.view.debugMonitor" name="VERTEX Debug Monitor" category="org.vertex.abap.ui.category" class="org.vertex.abap.ui.DebugMonitorView" allowMultiple="true" restorable="false"/>
      <view id="org.vertex.abap.ui.view.visualFlowAnalysis" name="Visual Flow Analysis" category="org.vertex.abap.ui.category" class="org.vertex.abap.ui.VisualFlowAnalysisView" allowMultiple="true" restorable="false"/>
      <view id="org.vertex.abap.ui.view.tools" name="VERTEX Tools" category="org.vertex.abap.ui.category" class="org.vertex.abap.ui.ToolsView" allowMultiple="true" restorable="false"/>
      <category
            id="org.vertex.abap.ui.category"
            name="VERTEX"/>




      <view
            id="org.vertex.abap.ui.view.valueOrigin"
            name="Value origin"
            category="org.vertex.abap.ui.category"
            class="org.vertex.abap.ui.ValueOriginView"
            allowMultiple="true"
            restorable="false"/>
      <view
            id="org.vertex.abap.ui.view.review"
            name="VERTEX Review"
            category="org.vertex.abap.ui.category"
            class="org.vertex.abap.ui.ReviewView"
            allowMultiple="true"
            restorable="false"/>
   </extension>

   <!-- Without this the views land in whichever stack the perspective happens to
        offer, which is usually a narrow strip on the right - useless for a grid.
        visible="false" only reserves the place; nothing opens on its own. The
        user can drag them anywhere afterwards and Eclipse remembers. -->


   <extension point="org.eclipse.ui.commands">
      <command id="org.vertex.abap.ui.command.debugMonitor" name="VERTEX: Debug Monitor" description="Observe the existing ADT debug session"/>
      <command id="org.vertex.abap.ui.command.tools" name="VERTEX Tools"/>
      <command id="org.vertex.abap.ui.command.visualFlowAnalysis" name="VERTEX: Visual Flow Analysis" description="Static calls and method logic without running the program"/>



      <command
            id="org.vertex.abap.ui.command.valueOrigin"
            name="VERTEX: Forward Usage Analysis"
            description="How the value under the cursor is computed, down from this line across calls, without running the program; with no value under the cursor, the flow from this line on"/>
      <command
            id="org.vertex.abap.ui.command.backwardUsage"
            name="VERTEX: Backward Usage Analysis"
            description="Where the values of the routine at the cursor go in its callers, up through theirs, by SAP's where-used"/>
      <command
            id="org.vertex.abap.ui.command.activate"
            name="VERTEX: Activate"
            description="Activate the object in the editor, with a block review of its inactive changes first"/>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler commandId="org.vertex.abap.ui.command.debugMonitor" class="org.vertex.abap.ui.DebugMonitorHandler"/>
      <handler commandId="org.vertex.abap.ui.command.tools" class="org.vertex.abap.ui.ToolsHandler"/>
      <handler commandId="org.vertex.abap.ui.command.visualFlowAnalysis" class="org.vertex.abap.ui.VisualFlowAnalysisHandler"/>



      <handler
            commandId="org.vertex.abap.ui.command.valueOrigin"
            class="org.vertex.abap.ui.ValueOriginHandler"/>
      <handler
            commandId="org.vertex.abap.ui.command.backwardUsage"
            class="org.vertex.abap.ui.BackwardUsageHandler"/>
      <handler
            commandId="org.vertex.abap.ui.command.activate"
            class="org.vertex.abap.ui.ActivateHandler"/>
   </extension>

   <!-- One submenu holding every service, rather than one top-level entry each:
        with several tools a flat list would crowd the context menu of every
        object. The visibility test sits on the menu, so it is evaluated once
        instead of once per command.

        Services differ in what they apply to - metrics to code, SelecTor to
        tables and views. Filtering that needs a PropertyTester, since plugin.xml
        has no built-in test for ADT object types; worth adding once a service is
        actually shown where it makes no sense. -->
   <extension point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <command commandId="org.vertex.abap.ui.command.tools" label="VERTEX Tools" style="push">
            <visibleWhen checkEnabled="false"><or>
               <with variable="selection"><count value="1"/><iterate><adapt type="com.sap.adt.tools.core.IAdtObjectReference"/></iterate></with>
               <with variable="activePart"><test property="org.vertex.abap.ui.adtObject" forcePluginActivation="true"/></with>
            </or></visibleWhen>
         </command>
      </menuContribution>
      <!-- In the context menu of an editor showing an ADT object. -->
      <menuContribution
            locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <command
               commandId="org.vertex.abap.ui.command.activate"
               label="VERTEX: Activate"
               style="push">
            <visibleWhen checkEnabled="false">
               <with variable="activePart">
                  <test property="org.vertex.abap.ui.adtObject" forcePluginActivation="true"/>
               </with>
            </visibleWhen>
         </command>
      </menuContribution>
   </extension>
   <extension point="org.eclipse.core.expressions.propertyTesters">
      <propertyTester
            id="org.vertex.abap.ui.editorTester"
            type="org.eclipse.ui.IEditorPart"
            namespace="org.vertex.abap.ui"
            properties="adtObject,valueOriginSource"
            class="org.vertex.abap.ui.EditorTester"/>
   </extension>
   <!-- The context menu of an ADT editor. Not #EditorContext: an ADT editor's menu is not always registered under that
        id (ADT 3.60 in Eclipse 2025-03 showed none of these there), so the items go to every popup and show only when
        the active part is an editor this tester accepts - any ADT object: a command that does not apply to the object
        says so and names its type, rather than the item silently missing (as it did in ADT 3.60's class editor). The editor itself is tested, as ADT tests its own commands:
        its input does not adapt to the object reference a plain plugin.xml test could name. -->
   <extension point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <command commandId="org.vertex.abap.ui.command.debugMonitor" label="VERTEX: Debug Monitor" style="push"><visibleWhen checkEnabled="false"><with variable="activePart"><test property="org.vertex.abap.ui.adtObject" forcePluginActivation="true"/></with></visibleWhen></command>
         <command commandId="org.vertex.abap.ui.command.visualFlowAnalysis" label="VERTEX: Visual Flow Analysis" style="push">
            <visibleWhen checkEnabled="false"><with variable="activePart"><test property="org.vertex.abap.ui.adtObject" forcePluginActivation="true"/></with></visibleWhen>
         </command>
         <command
               commandId="org.vertex.abap.ui.command.valueOrigin"
               label="VERTEX: Forward Usage Analysis"
               style="push">
            <visibleWhen checkEnabled="false">
               <with variable="activePart">
                  <test property="org.vertex.abap.ui.adtObject" forcePluginActivation="true"/>
               </with>
            </visibleWhen>
         </command>
         <command
               commandId="org.vertex.abap.ui.command.backwardUsage"
               label="VERTEX: Backward Usage Analysis"
               style="push">
            <visibleWhen checkEnabled="false">
               <with variable="activePart">
                  <test property="org.vertex.abap.ui.adtObject" forcePluginActivation="true"/>
               </with>
            </visibleWhen>
         </command>
      </menuContribution>
   </extension>
</plugin>