<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.preferencePages">
      <page id="org.vertex.abap.ui.assistant.preferences"
            name="VERTEX Assistant" class="org.vertex.abap.ui.AssistantPreferences"/>
      <page id="org.vertex.abap.ui.review.preferences"
            name="VERTEX Code Review" class="org.vertex.abap.ui.ReviewPreferences"/>
      <page id="org.vertex.abap.ui.path.preferences"
            name="VERTEX Path to This Line" class="org.vertex.abap.ui.PathPreferences"/>
   </extension>
   <extension point="org.eclipse.ui.views">
      <view id="org.vertex.abap.ui.view.debugMonitor" name="Visual Debug" category="org.vertex.abap.ui.category" class="org.vertex.abap.ui.DebugMonitorView" allowMultiple="true" restorable="false"/>
      <view id="org.vertex.abap.ui.view.visualFlowAnalysis" name="Visual Flow Analysis" category="org.vertex.abap.ui.category" class="org.vertex.abap.ui.VisualFlowAnalysisView" allowMultiple="true" restorable="false"/>
      <view id="org.vertex.abap.ui.view.tools" name="VERTEX Tools" category="org.vertex.abap.ui.category" class="org.vertex.abap.ui.ToolsView" allowMultiple="true" restorable="false"/>
      <category
            id="org.vertex.abap.ui.category"
            name="VERTEX"/>




      <view
            id="org.vertex.abap.ui.view.valueOrigin"
            name="Value origin"
            category="org.vertex.abap.ui.category"
            class="org.vertex.abap.ui.ValueOriginView"
            allowMultiple="true"
            restorable="false"/>
      <view
            id="org.vertex.abap.ui.view.chat"
            name="VERTEX Assistant"
            category="org.vertex.abap.ui.category"
            class="org.vertex.abap.ui.ChatView"
            allowMultiple="true"
            restorable="false"/>
      <view
            id="org.vertex.abap.ui.view.logs"
            name="Session Logs"
            category="org.vertex.abap.ui.category"
            class="org.vertex.abap.ui.LogsView"
            allowMultiple="false"
            restorable="false"/>
      <view
            id="org.vertex.abap.ui.view.reachPath"
            name="Path to line"
            category="org.vertex.abap.ui.category"
            class="org.vertex.abap.ui.ReachPathView"
            allowMultiple="true"
            restorable="false"/>
      <view
            id="org.vertex.abap.ui.view.review"
            name="VERTEX Review"
            category="org.vertex.abap.ui.category"
            class="org.vertex.abap.ui.ReviewView"
            allowMultiple="true"
            restorable="false"/>
   </extension>

   <!-- Without this the views land in whichever stack the perspective happens to
        offer, which is usually a narrow strip on the right - useless for a grid.
        visible="false" only reserves the place; nothing opens on its own. The
        user can drag them anywhere afterwards and Eclipse remembers. -->


   <extension point="org.eclipse.ui.commands">
      <command id="org.vertex.abap.ui.command.debugMonitor" name="VERTEX: Open Visual Debug" description="Open Visual Debug for the ADT debug session"/>
      <command id="org.vertex.abap.ui.command.tools" name="VERTEX Tools"/>
      <command id="org.vertex.abap.ui.command.visualFlowAnalysis" name="VERTEX: Visual Flow Analysis" description="Static calls and method logic without running the program"/>



      <command
            id="org.vertex.abap.ui.command.valueOrigin"
            name="VERTEX: Forward Usage Analysis"
            description="How the value under the cursor is computed, down from this line across calls, without running the program; with no value under the cursor, the flow from this line on"/>
      <command
            id="org.vertex.abap.ui.command.backwardUsage"
            name="VERTEX: Backward Usage Analysis"
            description="Where the values of the routine at the cursor go in its callers, up through theirs, by SAP's where-used"/>
      <command
            id="org.vertex.abap.ui.command.chat"
            name="VERTEX Assistant"
            description="The VERTEX chat in a window of its own, on the system of the selected object"/>
      <command
            id="org.vertex.abap.ui.command.logs"
            name="VERTEX: Session Logs"
            description="The assistant's conversation logs, as VS Code shows them"/>
      <command
            id="org.vertex.abap.ui.command.reachPath"
            name="VERTEX: Path to This Line"
            description="The conditions under which the line at the cursor runs inside its METHOD or FORM"/>
      <command
            id="org.vertex.abap.ui.command.activate"
            name="VERTEX: Activate"
            description="Activate the object in the editor, with a block review of its inactive changes first"/>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler commandId="org.vertex.abap.ui.command.debugMonitor" class="org.vertex.abap.ui.DebugMonitorHandler"/>
      <handler commandId="org.vertex.abap.ui.command.tools" class="org.vertex.abap.ui.ToolsHandler"/>
      <handler commandId="org.vertex.abap.ui.command.visualFlowAnalysis" class="org.vertex.abap.ui.VisualFlowAnalysisHandler"/>



      <handler
            commandId="org.vertex.abap.ui.command.valueOrigin"
            class="org.vertex.abap.ui.ValueOriginHandler"/>
      <handler
            commandId="org.vertex.abap.ui.command.backwardUsage"
            class="org.vertex.abap.ui.BackwardUsageHandler"/>
      <handler
            commandId="org.vertex.abap.ui.command.chat"
            class="org.vertex.abap.ui.ChatHandler"/>
      <handler
            commandId="org.vertex.abap.ui.command.logs"
            class="org.vertex.abap.ui.LogsHandler"/>
      <handler
            commandId="org.vertex.abap.ui.command.reachPath"
            class="org.vertex.abap.ui.ReachPathHandler"/>
      <handler
            commandId="org.vertex.abap.ui.command.activate"
            class="org.vertex.abap.ui.ActivateHandler"/>
   </extension>

   <!-- Every VERTEX item in one VERTEX submenu, beside GitHub, Team and Run As: one by one they filled the bottom of
        ADT's long editor menu. It stays in "additions", the group every popup has - a contribution whose group a
        menu lacks is dropped (anchored at group.undo, then group.open, VERTEX vanished from ADT's editor menu). Not
        #EditorContext: an ADT editor's menu is not always registered under that id. The submenu shows where VERTEX
        Tools does; an editor item shows only when the active part is an editor the tester accepts - any ADT object. -->
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <menu id="org.vertex.abap.ui.menu" label="VERTEX">
            <visibleWhen checkEnabled="false"><or><with variable="selection"><count value="1"/><iterate><adapt type="com.sap.adt.tools.core.IAdtObjectReference"/></iterate></with><with variable="activePart"><test property="org.vertex.abap.ui.adtObject" forcePluginActivation="true"/></with></or></visibleWhen>
            <command commandId="org.vertex.abap.ui.command.tools" label="VERTEX Tools" style="push"><visibleWhen checkEnabled="false"><or><with variable="selection"><count value="1"/><iterate><adapt type="com.sap.adt.tools.core.IAdtObjectReference"/></iterate></with><with variable="activePart"><test property="org.vertex.abap.ui.adtObject" forcePluginActivation="true"/></with></or></visibleWhen></command>
            <command commandId="org.vertex.abap.ui.command.reachPath" label="Path to This Line" style="push"><visibleWhen checkEnabled="false"><with variable="activePart"><test property="org.vertex.abap.ui.adtObject" forcePluginActivation="true"/></with></visibleWhen></command>
            <command commandId="org.vertex.abap.ui.command.valueOrigin" label="Forward Usage Analysis" style="push"><visibleWhen checkEnabled="false"><with variable="activePart"><test property="org.vertex.abap.ui.adtObject" forcePluginActivation="true"/></with></visibleWhen></command>
            <command commandId="org.vertex.abap.ui.command.backwardUsage" label="Backward Usage Analysis" style="push"><visibleWhen checkEnabled="false"><with variable="activePart"><test property="org.vertex.abap.ui.adtObject" forcePluginActivation="true"/></with></visibleWhen></command>
            <command commandId="org.vertex.abap.ui.command.visualFlowAnalysis" label="Visual Flow Analysis" style="push"><visibleWhen checkEnabled="false"><with variable="activePart"><test property="org.vertex.abap.ui.adtObject" forcePluginActivation="true"/></with></visibleWhen></command>
            <command commandId="org.vertex.abap.ui.command.debugMonitor" label="Open Visual Debug" style="push"><visibleWhen checkEnabled="false"><with variable="activePart"><test property="org.vertex.abap.ui.adtObject" forcePluginActivation="true"/></with></visibleWhen></command>
            <command commandId="org.vertex.abap.ui.command.activate" label="Activate" style="push"><visibleWhen checkEnabled="false"><with variable="activePart"><test property="org.vertex.abap.ui.adtObject" forcePluginActivation="true"/></with></visibleWhen></command>
            <separator name="vertex.logs" visible="true"/>
            <command commandId="org.vertex.abap.ui.command.chat" label="VERTEX Assistant" style="push"></command>
            <command commandId="org.vertex.abap.ui.command.logs" label="Session Logs" style="push"></command>
         </menu>
      </menuContribution>
   </extension>
   <extension point="org.eclipse.core.expressions.propertyTesters">
      <propertyTester
            id="org.vertex.abap.ui.editorTester"
            type="org.eclipse.ui.IEditorPart"
            namespace="org.vertex.abap.ui"
            properties="adtObject,valueOriginSource"
            class="org.vertex.abap.ui.EditorTester"/>
   </extension>
</plugin>