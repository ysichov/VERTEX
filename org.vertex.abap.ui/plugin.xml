<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.preferencePages">
      <page id="org.vertex.abap.ui.assistant.preferences"
            name="VERTEX Assistant" class="org.vertex.abap.ui.AssistantPreferences"/>
   </extension>
   <extension point="org.eclipse.ui.views">
      <view id="org.vertex.abap.ui.view.tools" name="VERTEX Tools" category="org.vertex.abap.ui.category" class="org.vertex.abap.ui.ToolsView" allowMultiple="true" restorable="false"/>
      <category
            id="org.vertex.abap.ui.category"
            name="VERTEX"/>




      <view
            id="org.vertex.abap.ui.view.review"
            name="VERTEX Review"
            category="org.vertex.abap.ui.category"
            class="org.vertex.abap.ui.ReviewView"
            allowMultiple="true"
            restorable="false"/>
   </extension>

   <!-- Without this the views land in whichever stack the perspective happens to
        offer, which is usually a narrow strip on the right - useless for a grid.
        visible="false" only reserves the place; nothing opens on its own. The
        user can drag them anywhere afterwards and Eclipse remembers. -->


   <extension point="org.eclipse.ui.commands">
      <command id="org.vertex.abap.ui.command.tools" name="VERTEX Tools"/>



      <command
            id="org.vertex.abap.ui.command.activate"
            name="VERTEX: Activate"
            description="Activate the object in the editor, with a block review of its inactive changes first"/>
   </extension>

   <extension point="org.eclipse.ui.handlers">
      <handler commandId="org.vertex.abap.ui.command.tools" class="org.vertex.abap.ui.ToolsHandler"/>



      <handler
            commandId="org.vertex.abap.ui.command.activate"
            class="org.vertex.abap.ui.ActivateHandler"/>
   </extension>

   <!-- One submenu holding every service, rather than one top-level entry each:
        with several tools a flat list would crowd the context menu of every
        object. The visibility test sits on the menu, so it is evaluated once
        instead of once per command.

        Services differ in what they apply to - metrics to code, SelecTor to
        tables and views. Filtering that needs a PropertyTester, since plugin.xml
        has no built-in test for ADT object types; worth adding once a service is
        actually shown where it makes no sense. -->
   <extension point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <command commandId="org.vertex.abap.ui.command.tools" label="VERTEX Tools" style="push">
            <visibleWhen checkEnabled="false"><or>
               <with variable="selection"><count value="1"/><iterate><adapt type="com.sap.adt.tools.core.IAdtObjectReference"/></iterate></with>
               <with variable="activeEditorInput"><adapt type="com.sap.adt.tools.core.IAdtObjectReference"/></with>
            </or></visibleWhen>
         </command>
      </menuContribution>
      <!-- In the context menu of an editor showing an ADT object. -->
      <menuContribution
            locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <command
               commandId="org.vertex.abap.ui.command.activate"
               label="VERTEX: Activate"
               style="push">
            <visibleWhen checkEnabled="false">
               <and>
                  <with variable="activePart">
                     <instanceof value="org.eclipse.ui.IEditorPart"/>
                  </with>
                  <with variable="activeEditorInput">
                     <adapt type="com.sap.adt.tools.core.IAdtObjectReference"/>
                  </with>
               </and>
            </visibleWhen>
         </command>
      </menuContribution>
   </extension>
</plugin>
