    "configuration": {
      "title": "VERTEX",
      "properties": {
        "vertex.mcp.port": {
          "type": "integer",
          "default": 37777,
          "minimum": 0,
          "maximum": 65535,
          "markdownDescription": "[Add the VERTEX MCP server to Claude Code or Codex](command:vertex.mcpAddress) - copies what to paste: a command for Claude Code, a config section for Codex. Copilot finds the server by itself.\n\nLocal MCP port for Codex, Claude Code and Copilot. Reload the window after changing it. Use a different port for each simultaneous VERTEX window; 0 selects a temporary port. The bearer token is kept in VS Code SecretStorage."
        },
        "vertex.systems": {
          "type": "array",
          "default": [],
          "markdownDescription": "The ABAP systems this extension can read. One of them is active at a time - see `vertex.active`, or the **VERTEX: Switch System** command.\n\n[Import from SAP Logon and Eclipse](command:vertex.importSystems) · [Test the connections](command:vertex.testSystems)\n\nImport reads each system's host and instance from SAP Logon, the client and user from an Eclipse ADT workspace, and looks for the ADT address on the usual ports. The HTTP(S) port is also in SMICM > Goto > Services.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "url",
              "user"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "How this system is called in the switch list. Also what its stored password is filed under."
              },
              "url": {
                "type": "string",
                "markdownDescription": "Base URL, for example `https://host.example.com:44300`. This is the ICM port, not the one SAP GUI connects to."
              },
              "client": {
                "type": "string",
                "description": "SAP client, sent as sap-client. Leave empty to use the system default."
              },
              "user": {
                "type": "string",
                "description": "SAP user. The password is asked once and kept in the OS credential store, per system."
              },
              "webgui": {
                "type": "string",
                "markdownDescription": "Optional. Where the debugger opens WebGUI for this system, for example `https://10.0.0.5:44300`, when it is not `url`. Needed when SAP redirects WebGUI to a host name this computer cannot resolve."
              },
              "allowInsecureCertificate": {
                "type": "boolean",
                "default": false,
                "markdownDescription": "Accept a server certificate that cannot be verified. Development systems often have one. **Off by default on purpose** - turning it on disables certificate checking for requests to this system."
              }
            }
          }
        },
        "vertex.active": {
          "type": "string",
          "default": "",
          "markdownDescription": "Which of `vertex.systems` to read from. Empty means the first one."
        },
        "vertex.ai.provider": {
          "type": "string",
          "enum": [
            "claude-subscription",
            "codex-subscription",
            "copilot",
            "anthropic-api",
            "openai-api"
          ],
          "default": "codex-subscription",
          "markdownDescription": "AI provider used by the VERTEX assistant. API keys are kept in SecretStorage."
        },
        "vertex.ai.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model passed to the selected Codex or Claude subscription. Empty uses its weakest model (Claude: haiku; Codex: the last in its catalog)."
        },
        "vertex.ai.modelConfig": {
          "type": "object",
          "default": {},
          "markdownDescription": "Which models VERTEX offers per provider (`claude`, `codex`, `anthropic-api`): `hidden` model ids are left out of every model list, `versions` are Claude models checked by full id, `off: true` leaves the provider out of every provider choice. Edited with **Config models** in the VERTEX panel."
        },
        "vertex.ai.logPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder for a Claude-Code-compatible chat log (`claude_compatible/*.jsonl`). Token usage is always written; the checkboxes below add more. Empty turns logging off."
        },
        "vertex.ai.log.questions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Log the text of your chat questions."
        },
        "vertex.ai.log.answers": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Log the text of the assistant's answers."
        },
        "vertex.ai.log.tools": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Log SAP tool calls: names, arguments and a summary of each result (object, size, error), without source."
        },
        "vertex.ai.log.code": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also log SAP source inside tool calls and results. Takes effect only with **Log tools**."
        },
        "vertex.ai.personalInstructions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Let Claude Code load your personal CLAUDE.md and auto-memory for VERTEX requests. Off by default: they travel with every SAP request and can show up in answers."
        }
      }
    },
