    "configuration": {
      "title": "VERTEX",
      "properties": {
        "vertex.mcp.port": {
          "type": "integer",
          "default": 37777,
          "minimum": 0,
          "maximum": 65535,
          "markdownDescription": "[Add the VERTEX MCP server to Claude Code or Codex](command:vertex.mcpAddress) - copies what to paste: a command for Claude Code, a config section for Codex. Copilot finds the server by itself.\n\nLocal MCP port for Codex, Claude Code and Copilot. Reload the window after changing it. Use a different port for each simultaneous VERTEX window; 0 selects a temporary port. The bearer token is kept in VS Code SecretStorage."
        },
        "vertex.systems": {
          "type": "array",
          "default": [],
          "markdownDescription": "The ABAP systems this extension can read. One of them is active at a time - see `vertex.active`, or the **VERTEX: Switch System** command.\n\n[Import from SAP Logon and Eclipse](command:vertex.importSystems) · [Remove configured systems](command:vertex.removeSystems) · [Test the connections](command:vertex.testSystems)\n\nImport reads each system's host and instance from SAP Logon, the client and user from an Eclipse ADT workspace, and looks for the ADT address on the usual ports. A direct SAP Logon SNC entry also supplies its SNC name, protection level and RFC server. The HTTP(S) port is also in SMICM > Goto > Services.\n\nFor SNC, use authType snc with snc and rfc.",
          "items": {
            "type": "object",
            "required": [
              "url",
              "user"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "How this system is called in the switch list."
              },
              "url": {
                "type": "string",
                "markdownDescription": "Base URL, for example `https://host.example.com:44300`. This is the ICM port, not the one SAP GUI connects to."
              },
              "client": {
                "type": "string",
                "description": "SAP client, sent as sap-client. Leave empty to use the system default."
              },
              "user": {
                "type": "string",
                "description": "SAP user. For basic, the logon user — its password is asked once and kept in the OS credential store. For snc, the ABAP user the debugger targets; no password."
              },
              "authType": {
                "type": "string",
                "enum": [
                  "basic",
                  "snc"
                ],
                "default": "basic",
                "description": "Authentication type. basic uses a password; snc uses Secure Login Client over RFC. Never put a password in settings."
              },
              "snc": {
                "type": "object",
                "description": "SNC settings, required for snc authentication.",
                "properties": {
                  "partnerName": {
                    "type": "string",
                    "description": "Required. The system's SNC name, for example p:CN=SID, O=ACME."
                  },
                  "qop": {
                    "type": "string",
                    "enum": [
                      "1",
                      "2",
                      "3",
                      "8",
                      "9"
                    ],
                    "description": "Optional SNC quality of protection."
                  },
                  "library": {
                    "type": "string",
                    "description": "Optional SNC library path; discovered when absent."
                  },
                  "myName": {
                    "type": "string",
                    "description": "Optional local SNC name."
                  }
                }
              },
              "rfc": {
                "type": "object",
                "description": "RFC address, required for snc; never derived from url.",
                "properties": {
                  "ashost": {
                    "type": "string",
                    "description": "Required. Application server host."
                  },
                  "sysnr": {
                    "type": "string",
                    "pattern": "^\\d\\d$",
                    "description": "Required. Two-digit instance number."
                  },
                  "saprouter": {
                    "type": "string",
                    "description": "Optional SAProuter string."
                  }
                }
              },
              "webgui": {
                "type": "string",
                "markdownDescription": "Optional. Where the debugger opens WebGUI for this system, for example `https://10.0.0.5:44300`, when it is not `url`. Needed when SAP redirects WebGUI to a host name this computer cannot resolve."
              },
              "allowInsecureCertificate": {
                "type": "boolean",
                "default": false,
                "markdownDescription": "Accept a server certificate that cannot be verified. Development systems often have one. **Off by default on purpose** - turning it on disables certificate checking for requests to this system."
              }
            }
          }
        },
        "vertex.active": {
          "type": "string",
          "default": "",
          "markdownDescription": "Which of `vertex.systems` to read from. Empty means the first one."
        },
        "vertex.ai.provider": {
          "type": "string",
          "enum": [
            "claude-subscription",
            "codex-subscription",
            "copilot",
            "anthropic-api",
            "openai-api",
            "mistral-api",
            "gemini-api",
            "groq-api",
            "cerebras-api",
            "openrouter-api",
            "nvidia-api"
          ],
          "default": "codex-subscription",
          "markdownDescription": "AI provider used by the VERTEX assistant. API keys are kept in SecretStorage."
        },
        "vertex.ai.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model passed to the selected provider. Empty uses the first enabled model."
        },
        "vertex.ai.modelConfig": {
          "type": "object",
          "default": {},
          "markdownDescription": "Which models VERTEX offers per provider (`claude`, `codex`, `copilot` and API providers): `hidden` model ids are left out of every model list, `versions` are Claude models checked by full id, `off: true` leaves the provider out of every provider choice. Edited with **Config models** in the VERTEX panel."
        },
        "vertex.transpiler.runPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder that keeps each transpiler run of the chat as a folder of its own: its record, output and the sources it stepped through. A kept run opens again after a restart, from a chat citation or with **VERTEX: Open Transpiler Run...**, and its folder can be handed to someone else. Empty keeps runs for this session only."
        },
        "vertex.debug.runPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder for saved SAP debug recordings. Empty uses VERTEX's extension storage. Open the searchable run list with **VERTEX: SAP Debug Runs...**."
        },
        "vertex.ai.logPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "[Choose folder](command:vertex.ai.chooseLogFolder) for an Anthropic-compatible log (`claude_compatible/*.jsonl`). Each direct API or VS Code model call is recorded; CLI subscriptions are logged per VERTEX invocation. The checkboxes below control retained content. Empty turns logging off."
        },
        "vertex.ai.log.questions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Log the text of your chat questions."
        },
        "vertex.ai.log.answers": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Log the text of the assistant's answers."
        },
        "vertex.ai.log.tools": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Log SAP tool calls: names, arguments and a summary of each result (object, size, error), without source."
        },
        "vertex.ai.log.code": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also log SAP source inside tool calls and results. Takes effect only with **Log tools**."
        },
        "vertex.ai.log.request": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Log VERTEX's full instructions and composed model request, including workspace and visible UML/code context, available tool definitions and answer schema. May contain source code, conversation history and local paths. Applies only to new requests; provider-internal instructions are not available to VERTEX."
        },
        "vertex.ai.personalInstructions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Let Claude Code load your personal CLAUDE.md and auto-memory for VERTEX requests. Off by default: they travel with every SAP request and can show up in answers."
        },
        "vertex.review.storage": {
          "type": "string",
          "enum": [
            "table",
            "file",
            "both"
          ],
          "default": "table",
          "enumDescriptions": [
            "SAP's ZAVE_REVIEW table, shared with AVE and every VERTEX window on that system.",
            "A JSON file per request in the review folder.",
            "Both: the table is read first, and every save writes both."
          ],
          "markdownDescription": "Where a code review is saved. The table needs VERTEX's ABAP on the system (`ZCL_VX_ADT_RES_STORE`); on a system without it reviews are saved to files only, and the review says so."
        },
        "vertex.review.folder": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder for reviews saved to files, one `<system>/<request>.json` each. Empty means `.vertex/reviews` in the first workspace folder; a relative path is taken from there too."
        }
      }
    },
    "mcpServerDefinitionProviders": [
