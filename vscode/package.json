        "key": "f1",
        "when": "editorTextFocus && editorLangId == abap && (resourceScheme == vertex-sap || resourceScheme == vertex-source)"
      },
      {
        "command": "vertex.runAtc",
        "key": "ctrl+shift+f2",
        "when": "resourceScheme == vertex-sap"
      }
    ],
