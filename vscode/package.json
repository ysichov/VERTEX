{
  "name": "vertex-abap",
  "displayName": "SAP ABAP VERTEX Tools",
  "description": "ABAP chat and code reviewer with Save & Activate, Versions/Reviewer, Data/Code Explorers + MCP server",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ysichov/VERTEX.git"
  },
  "bugs": {
    "url": "https://github.com/ysichov/VERTEX/issues"
  },
  "homepage": "https://github.com/ysichov/VERTEX",
  "keywords": [
    "abap",
    "sap",
    "adt",
    "sql",
    "pivot",
    "code review",
    "mcp",
    "ai",
    "copilot",
    "claude code",
    "codex",
    "reviewer"
  ],
  "version": "0.5.4",
  "publisher": "YuriiSychov",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "AI",
    "Chat",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:vertex-sap"
  ],
  "icon": "images/icon.png",
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vertex",
          "title": "VERTEX",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "vertex": [
        {
          "id": "vertex.launcher",
          "name": "SAP Tools",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "vertex.showPanel",
        "title": "VERTEX: Open Panel"
      },
      {
        "command": "vertex.open",
        "title": "VERTEX: Open SelecTor"
      },
      {
        "command": "vertex.metrics",
        "title": "VERTEX: Open Metrics"
      },
      {
        "command": "vertex.versions",
        "title": "VERTEX: Open Versions"
      },
      {
        "command": "vertex.switchSystem",
        "title": "VERTEX: Switch System"
      },
      {
        "command": "vertex.forgetPassword",
        "title": "VERTEX: Forget Password"
      },
      {
        "command": "vertex.mcpAddress",
        "title": "Copy the MCP address for Claude Code or Codex",
        "category": "VERTEX"
      },
      {
        "command": "vertex.saveAndActivate",
        "title": "Save & Activate",
        "category": "VERTEX",
        "icon": "$(save)"
      },
      {
        "command": "vertex.reviewCodeChanges",
        "title": "Review & Activate",
        "category": "VERTEX",
        "icon": "$(diff)"
      }
    ],
    "configuration": {
      "title": "VERTEX",
      "properties": {
        "vertex.mcp.port": {
          "type": "integer",
          "default": 37777,
          "minimum": 0,
          "maximum": 65535,
          "markdownDescription": "Local MCP port for Codex, Claude Code and Copilot. Reload the window after changing it. Use a different port for each simultaneous VERTEX window; 0 selects a temporary port. The bearer token is kept in VS Code SecretStorage."
        },
        "vertex.systems": {
          "type": "array",
          "default": [],
          "markdownDescription": "The ABAP systems this extension can read. One of them is active at a time - see `vertex.active`, or the **VERTEX: Switch System** command.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "url",
              "user"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "How this system is called in the switch list. Also what its stored password is filed under."
              },
              "url": {
                "type": "string",
                "markdownDescription": "Base URL, for example `https://host.example.com:44300`. This is the ICM port, not the one SAP GUI connects to."
              },
              "client": {
                "type": "string",
                "description": "SAP client, sent as sap-client. Leave empty to use the system default."
              },
              "user": {
                "type": "string",
                "description": "SAP user. The password is asked once and kept in the OS credential store, per system."
              },
              "allowInsecureCertificate": {
                "type": "boolean",
                "default": false,
                "markdownDescription": "Accept a server certificate that cannot be verified. Development systems often have one. **Off by default on purpose** - turning it on disables certificate checking for requests to this system."
              }
            }
          }
        },
        "vertex.active": {
          "type": "string",
          "default": "",
          "markdownDescription": "Which of `vertex.systems` to read from. Empty means the first one."
        },
        "vertex.ai.provider": {
          "type": "string",
          "enum": [
            "claude-subscription",
            "codex-subscription",
            "copilot",
            "anthropic-api",
            "openai-api"
          ],
          "default": "codex-subscription",
          "markdownDescription": "AI provider used by the VERTEX assistant. API keys are kept in SecretStorage."
        },
        "vertex.ai.model": {
          "type": "string",
          "default": "",
          "markdownDescription": "Model passed to the selected Codex or Claude subscription. Empty uses its default model."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "vertex",
        "label": "VERTEX SAP"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "vertex.saveAndActivate",
          "when": "resourceScheme == vertex-sap",
          "group": "1_modification@1"
        },
        {
          "command": "vertex.reviewCodeChanges",
          "when": "resourceScheme == vertex-sap",
          "group": "1_modification@2"
        }
      ],
      "editor/title": [
        {
          "command": "vertex.saveAndActivate",
          "when": "resourceScheme == vertex-sap",
          "group": "navigation@1"
        },
        {
          "command": "vertex.reviewCodeChanges",
          "when": "resourceScheme == vertex-sap",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "vscode:prepublish": "node ./copy-pages.js"
  },
  "dependencies": {
    "abap-adt-api": "8.4.3"
  }
}
